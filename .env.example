# Copy this file to .env.development and fill in real values.
# .env.development is git-ignored — never commit real credentials.

# Discogs OAuth 1.0a credentials
# See docs/discogs-api.md for API reference.
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
DISCOGS_REQUEST_TOKEN_URL=https://api.discogs.com/oauth/request_token
DISCOGS_AUTHORIZE_URL=https://www.discogs.com/oauth/authorize
DISCOGS_ACCESS_TOKEN_URL=https://api.discogs.com/oauth/access_token

# Anthropic Claude API credentials
# See docs/claude-usage.md for how this is used (suggestions + vibe search, both
# tool-forced taxonomy matching — not open-ended reasoning). Both call sites share
# this one model; every request also resends a large (~20K token) genre/style
# taxonomy block, so a cheap model matters a lot here. claude-haiku-4-5-20251001 is
# the recommended default — it's far cheaper than Sonnet/Opus and plenty capable
# for constrained, forced tool-use taxonomy picks.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
